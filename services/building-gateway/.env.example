# Salin ke .env (chmod 600, JANGAN di-commit)
HOST=127.0.0.1
PORT=3011

TB_INTERNAL_URL=http://localhost:8080
# WebSocket TB untuk realtime (default: TB_INTERNAL_URL dengan ws://)
# TB_WS_URL=ws://localhost:8080
TB_PUBLIC_URL=https://iot.get220v.com
PUBLIC_BASE_URL=https://iot.get220v.com/building-api

# Akun TENANT ADMIN khusus service (bukan akun admin harian)
TB_TENANT_USERNAME=
TB_TENANT_PASSWORD=

# Model building di TB
BUILDING_ASSET_TYPE=building
BUILDING_RELATION_TYPE=Contains
BUILDING_MAX_LEVEL=5
# asset type untuk lantai/ruang yang dibuat helper bulk
SPACE_ASSET_TYPE=space
TOPOLOGY_CACHE_SEC=60

CLIENTS_FILE=clients.json
TICKET_TTL_SEC=60
MIN_SESSION_SEC=1800
RATE_LIMIT_PER_MIN=300
ALARM_POLL_SEC=30
WEBHOOK_BATCH_MS=5000
# cache daftar client yang dikelola dari ThingsBoard (detik)
CLIENT_CACHE_SEC=30
# WS ke TB dibuka ulang kalau tidak ada pesan selama ini (detik)
REALTIME_STALE_SEC=300
