# SIAGA QR service — salin ke .env (JANGAN commit .env)
HOST=127.0.0.1
PORT=3021
# ThingsBoard internal (service memakai JWT user, tidak punya kredensial sendiri)
TB_INTERNAL_URL=http://localhost:8080
SIAGA_QR_DB_PATH=/var/lib/siaga-qr/siaga-qr.db

# Key (buat dengan: npm run keygen -- --kid siaga-qr-2026-01 --out /etc/siaga-qr)
SIAGA_QR_ACTIVE_KID=siaga-qr-2026-01
SIAGA_QR_SIGNING_KEY_FILE=/etc/siaga-qr/private/siaga-qr-2026-01.key
SIAGA_QR_PUBLIC_KEYS_DIR=/etc/siaga-qr/public
SIAGA_QR_DATA_KEY_FILE=/etc/siaga-qr/private/data.key

# Kebijakan
SIAGA_QR_DEFAULT_VALID_DAYS=1825
SIAGA_QR_MAX_VALID_DAYS=3650
SIAGA_QR_CLOCK_SKEW_SEC=300
SIAGA_QR_SYNC_BATCH_MAX=100
SIAGA_QR_EXPORT_TTL_SEC=300

# Batas
SIAGA_QR_MAX_BODY_BYTES=16384
SIAGA_QR_RATE_LIMIT_PER_MIN=120
SIAGA_QR_VERIFY_RATE_LIMIT_PER_MIN=60
SIAGA_QR_IP_RATE_LIMIT_PER_MIN=600
SIAGA_QR_AUTH_CACHE_SEC=30
# Aplikasi Android tidak butuh CORS; isi hanya untuk web app (koma)
SIAGA_QR_CORS_ORIGINS=
# 1 = percaya X-Forwarded-For dari nginx lokal
SIAGA_QR_TRUST_PROXY=1
