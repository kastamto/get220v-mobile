# Salin ke .env (JANGAN di-commit). Semua kredensial TB hanya hidup di server.
HOST=127.0.0.1
PORT=3010

# TB dipanggil dari server lewat localhost; URL publik dipakai untuk link yang dibuka app
TB_INTERNAL_URL=http://localhost:8080
TB_PUBLIC_URL=https://iot.get220v.com
# URL publik service ini (lokasi nginx), dipakai untuk membentuk embedUrl
PUBLIC_BASE_URL=https://iot.get220v.com/dash-embed

# Akun TENANT ADMIN (bukan sysadmin) — dipakai server-side untuk minta token user embed.
# Sebaiknya akun khusus, mis. embed-svc@get220v.id, bukan akun admin harian.
TB_TENANT_USERNAME=
TB_TENANT_PASSWORD=

APPS_FILE=apps.json
# umur link /e/<ticket> (sekali pakai)
TICKET_TTL_SEC=60
# token user embed diperbarui bila sisa umurnya < ini (detik)
MIN_SESSION_SEC=1800
RATE_LIMIT_PER_MIN=120
